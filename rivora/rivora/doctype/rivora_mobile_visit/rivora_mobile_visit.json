{
  "doctype": "DocType",
  "name": "Rivora Mobile Visit",
  "module": "Rivora",
  "engine": "InnoDB",
  "field_order": [
    "title",
    "employee",
    "date",
    "customer",
    "latitude",
    "longitude",
    "photo",
    "notes"
  ],
  "fields": [
    {
      "fieldname": "title",
      "fieldtype": "Data",
      "label": "Title",
      "reqd": 1
    },
    {
      "fieldname": "employee",
      "fieldtype": "Link",
      "label": "Employee",
      "options": "Employee",
      "reqd": 1
    },
    {
      "fieldname": "date",
      "fieldtype": "Date",
      "label": "Date",
      "default": "Today"
    },
    {
      "fieldname": "customer",
      "fieldtype": "Link",
      "label": "Customer",
      "options": "Customer"
    },
    {
      "fieldname": "latitude",
      "fieldtype": "Float",
      "label": "Latitude"
    },
    {
      "fieldname": "longitude",
      "fieldtype": "Float",
      "label": "Longitude"
    },
    {
      "fieldname": "photo",
      "fieldtype": "Attach Image",
      "label": "Photo"
    },
    {
      "fieldname": "notes",
      "fieldtype": "Text Editor",
      "label": "Notes"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1
    },
    {
      "role": "Employee",
      "read": 1,
      "write": 1,
      "create": 1,
      "if_owner": 1
    }
  ],
  "autoname": "hash"
}